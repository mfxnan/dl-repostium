entrypoint = "server.js"
run = "python3 -m venv .venv && .venv/bin/python -m pip install --disable-pip-version-check -r requirements.txt && PYTHON=.venv/bin/python npm start"

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-lc", "python3 -m venv .venv && .venv/bin/python -m pip install --disable-pip-version-check -r requirements.txt"]
run = ["bash", "-lc", "PYTHON=.venv/bin/python npm start"]

[[ports]]
localPort = 3000
externalPort = 80
